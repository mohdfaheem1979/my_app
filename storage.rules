rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function active() {
      return signedIn() &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.active == true;
    }

    match /chat_files/{chatId}/{fileName} {
      allow read: if active();
      allow write: if active() && request.resource.size < 50 * 1024 * 1024;
    }

    match /profile_pictures/{uid}.jpg {
      allow read: if signedIn();
      allow write: if active() && request.auth.uid == uid
        && request.resource.size < 10 * 1024 * 1024;
    }
  }
}